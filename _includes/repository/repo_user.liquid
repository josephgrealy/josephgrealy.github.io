<div class="repo p-2 text-center">
  <a class="github-user-card" href="https://github.com/{{ include.username }}">
    <img
      class="github-user-avatar rounded-circle"
      alt="{{ include.username }}'s GitHub profile picture"
      src="https://github.com/{{ include.username }}.png?size=240"
      width="120"
      height="120"
    >
    <span>{{ include.username }}</span>
  </a>
</div>
